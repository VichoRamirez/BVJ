APP_NAME=NewsScraper
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Capa de IA. El driver se resuelve en config/newsscraper.php contra
# App\Contracts\NewsAnalyzer, para poder cambiar de proveedor sin tocar el pipeline.
#
# Valores: ollama | openrouter | chain | fake (fake solo en local y testing).
#
#   chain = probar varios modelos en orden y quedarse con el primero que responda.
#           Los eslabones se declaran en config/newsscraper.php (`ai.chain`).
#           Un eslabón mal configurado no rompe la cadena: se salta.
#
# Si no tienes Ollama instalado, usa `chain` u `openrouter`.
NEWS_AI_DRIVER=chain
NEWS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEWS_OLLAMA_MODEL=llama3.2:3b
NEWS_OLLAMA_CONNECT_TIMEOUT=3
NEWS_OLLAMA_TIMEOUT=60
NEWS_OLLAMA_RETRY_ATTEMPTS=2
NEWS_OLLAMA_RETRY_BACKOFF=100
NEWS_OLLAMA_MAX_RESPONSE_BYTES=1048576
# OpenRouter: API compatible con OpenAI, con modelos gratuitos.
#
# La clave se saca de https://openrouter.ai/keys y va SOLO en tu .env, que nunca
# se commitea. No la pegues en el chat, en el README ni en un issue.
# Sin ella, los eslabones `openrouter` de la cadena se saltan solos.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
# Opcionales, para que OpenRouter atribuya el tráfico:
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=NewsScraper
OPENROUTER_CONNECT_TIMEOUT=5
OPENROUTER_TIMEOUT=60
OPENROUTER_RETRY_ATTEMPTS=2
OPENROUTER_RETRY_BACKOFF=500
OPENROUTER_MAX_RESPONSE_BYTES=1048576

# Cadena de respaldo. Tras N fallos seguidos, un modelo se salta durante TTL
# segundos: sin esto, un proveedor caído se reintenta una vez por artículo.
NEWS_AI_CIRCUIT_FAILURES=3
NEWS_AI_CIRCUIT_TTL=300
# Cambiar de modelo también cuando el JSON viene mal. Apagado: suele ser culpa
# del prompt, y saltar al siguiente modelo lo esconde.
NEWS_AI_FALLBACK_ON_INVALID=false

NEWS_AI_JOB_TRIES=4
NEWS_AI_JOB_TIMEOUT=180
NEWS_AI_OVERLAP_RELEASE_AFTER=30
NEWS_AI_PROCESSING_STALE_AFTER=300
NEWS_AI_OVERLAP_TTL=240

# Pipeline de briefings
NEWS_EVENTS_PER_BRIEFING=7
NEWS_MIN_RELEVANCE=medium
NEWS_CLUSTER_WINDOW=24
NEWS_CLUSTER_THRESHOLD=0.62
NEWS_CLUSTER_MAX_ARTICLES=500
NEWS_CLUSTER_JOB_TIMEOUT=120

# Reintentos y candados de GenerateBriefingJob. El TTL del candado siempre queda
# por encima del timeout + 31 s: si el proceso muere sin soltarlo, expira solo.
NEWS_BRIEFING_JOB_TRIES=3
NEWS_BRIEFING_JOB_TIMEOUT=120
NEWS_BRIEFING_OVERLAP_RELEASE_AFTER=120
NEWS_BRIEFING_OVERLAP_TTL=151

# Scraping responsable: retardo entre requests y User-Agent identificable
NEWS_SCRAPE_DELAY=2
NEWS_SCRAPE_TIMEOUT=20
NEWS_MAX_ARTICLES=25
NEWS_SCRAPE_RETRY_ATTEMPTS=2
NEWS_SCRAPE_RETRY_BACKOFF=500
NEWS_SCRAPE_MAX_REDIRECTS=3
NEWS_SCRAPE_MAX_BYTES=5242880
NEWS_SCRAPE_ROBOTS_TTL=3600
NEWS_SCRAPE_VERIFY_PUBLIC_ADDRESS=true
# Cuánto texto se guarda de cada nota. Se recorta a propósito: no se republica
# el cuerpo con copyright, solo lo mínimo para analizar.
NEWS_MAX_CONTENT_CHARS=4000
NEWS_MAX_EXCERPT_CHARS=600
NEWS_USER_AGENT="NewsScraperBot/1.0 (proyecto academico IIP323W UDD)"

# Datos de mercado. Yahoo Finance no pide API key: el endpoint de gráficos es
# abierto y se identifica con NEWS_USER_AGENT. No hay ninguna credencial acá.
NEWS_MARKETS_PROVIDER=yahoo
NEWS_MARKETS_TIMEOUT=15
NEWS_MARKETS_RETRY_ATTEMPTS=2
NEWS_MARKETS_RETRY_BACKOFF=500
